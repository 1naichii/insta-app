{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "typecheck": "tsc --noEmit",
        "types:check": "tsc --noEmit",
        "lint": "eslint .",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:react": "vitest run",
        "test:react:watch": "vitest",
        "test:react:ui": "vitest --ui",
        "test:react:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report",
        "test:frontend": "bun run test:react && bun run test:e2e"
    },
    "packageManager": "bun@1.3.14",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "1.62.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "^22.13.5",
        "@vitest/coverage-v8": "4.1.10",
        "@vitest/ui": "4.1.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "10.8.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "jsdom": "30.0.0",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript-eslint": "8.65.0",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "@inertiajs/react": "3.6.1",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tailwindcss/vite": "4.3.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "6.0.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "globals": "^15.14.0",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "3.1.3",
        "lucide-react": "1.27.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "6.0.3",
        "vite": "8.1.5"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
